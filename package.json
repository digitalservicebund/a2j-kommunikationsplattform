{
  "name": "a2j-kommunikationsplattform",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "react-router build",
    "dev:op": "op run --no-masking node --env-file=.env.defaults --env-file=.env.op ./server.js",
    "start": "NODE_ENV=production node --env-file=.env.defaults ./server.js",
    "typecheck": "react-router typegen && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:generate-coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint:check": "oxlint",
    "lint:fix": "npm run lint:check -- --fix",
    "format:check": "oxfmt --check",
    "format:fix": "oxfmt",
    "preinstall": "echo 'Please disable script execution: npm config set ignore-scripts true' && exit 1",
    "style:check": "npm run format:check && npm run lint:check",
    "style:fix": "npm run format:fix && npm run lint:fix"
  },
  "dependencies": {
    "@kern-ux/native": "^2.8.2",
    "@react-router/express": "^8.4.0",
    "@react-router/node": "^8.4.0",
    "@react-router/serve": "^8.4.0",
    "@sentry/react-router": "^11.4.0",
    "better-auth": "^1.7.7",
    "clsx": "^2.1.1",
    "compression": "^1.8.2",
    "es-toolkit": "^1.52.0",
    "express": "^5.2.1",
    "isbot": "^5.2.2",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "undici": "^8.11.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/vite": "^4.2.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-istanbul": "^5.0.3",
    "@vitest/expect": "^5.0.3",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "msw": "^3.0.2",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "pino-pretty": "^13.1.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "@isaacs/brace-expansion": "5.0.1",
    "@react-router/serve": {
      "path-to-regexp": "0.1.13"
    },
    "minimatch": "10.2.3",
    "router": {
      "path-to-regexp": "8.4.0"
    }
  },
  "engines": {
    "node": ">=26.3.1"
  }
}
