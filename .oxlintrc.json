{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "jsx-a11y", "typescript"],
  "ignorePatterns": ["**/*", "!app/**", "!tests/**"],

  "options": {
    "typeAware": true,
    "maxWarnings": 0
  },

  "env": {
    "builtin": true,
    "es2024": true,
    "browser": true
  },

  "settings": {
    "react": {
      // Consider react-router <Form> a form element for the purpose of
      // form-related React rules.
      "formComponents": ["Form"]
    }
  },

  "categories": {
    "correctness": "warn",
    "suspicious": "warn"
  },

  "rules": {
    // TODO: Fix typescript/no-unsafe-type-assertion issues
    "typescript/no-unsafe-type-assertion": "off",

    "typescript/no-floating-promises": [
      "warn",
      {
        "allowForKnownSafeCalls": [
          // Ignore calls to navigate() (from react-router useNavigate())
          { "from": "file", "name": "navigate" }
        ]
      }
    ],

    // React 17+ does not require importing `React` for JSX
    "react/react-in-jsx-scope": "off",

    // TODO: Fix errors reported by this rule
    "react/set-state-in-effect": "off",

    "no-underscore-dangle": [
      "warn",
      {
        "allow": ["__mocks__"]
      }
    ],

    "no-unused-vars": [
      "warn",
      {
        "fix": { "imports": "safe-fix" },
        "argsIgnorePattern": "^_"
      }
    ]
  }
}
