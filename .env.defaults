# Default environment variable values used during local development.
#
# Sensitive values are NOT stored here; instead, they are loaded from a
# 1Password vault during local development. see `.env.op`.

# Deployment environment (development | staging | production)
ENVIRONMENT=development

# BRAK Identity Provider (beA)
BRAK_IDP_OIDC_CLIENT_ID=
BRAK_IDP_OIDC_CLIENT_SECRET=
BRAK_IDP_OIDC_ISSUER=
BRAK_IDP_OIDC_REDIRECT_URI=

# HTTP Basic Auth (staging / pre-launch only)
HTTP_CREDENTIALS_USERNAME=
HTTP_CREDENTIALS_PASSWORD=

# KomPla Backend API
KOMPLA_API_URL=

# KomPla Identity Provider
KOMPLA_IDP_OIDC_CLIENT_ID=
KOMPLA_IDP_OIDC_CLIENT_SECRET=
KOMPLA_IDP_OIDC_ISSUER=
KOMPLA_IDP_OIDC_BRAK_TOKEN_ENDPOINT=
KOMPLA_IDP_OIDC_BRAK_SUBJECT_ISSUER=
KOMPLA_IDP_OIDC_REDIRECT_URI=http://localhost:3000/auth/kompla-idp-callback

# Magic Link Login (Guest Access)
KOMPLA_MAGIC_LINK_SERVICE_CLIENT_ID=
KOMPLA_MAGIC_LINK_SERVICE_CLIENT_SECRET=
KOMPLA_MAGIC_LINK_CLIENT_ID=
KOMPLA_MAGIC_LINK_REDIRECT_URI=http://localhost:3000/auth/magic-link-callback
KOMPLA_MAGIC_LINK_DEMO_USERNAME=
KOMPLA_MAGIC_LINK_DEMO_EMAIL=

# Sentry
SENTRY_DSN=

# End-To-End Testing
E2E_BASE_URL=http://localhost:3000
