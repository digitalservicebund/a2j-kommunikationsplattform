# Overrides for `.env.defaults` using 1Password secret references.
#
# `npm run dev:op` uses the 1Password CLI's `op run` command to resolve the
# secret references to the secret values and provide them to the development
# server, without ever storing the secret values on disk. (This requires access
# to the development team's 1Password vault.)
#
# Note that `npm run dev:op` loads both `.env.defaults` and `.env.op`, so for
# any environment variable not specified here, the default value from
# `.env.defaults` is passed to the dev server instead.

# BRAK Identity Provider (beA)
BRAK_IDP_OIDC_CLIENT_ID="op://4ytk2qggj7l4yydaw64xktlosa/KOMPLA_BRAK_IDP_OIDC/client_id"
BRAK_IDP_OIDC_CLIENT_SECRET="op://4ytk2qggj7l4yydaw64xktlosa/KOMPLA_BRAK_IDP_OIDC/client_secret"
BRAK_IDP_OIDC_ISSUER="op://4ytk2qggj7l4yydaw64xktlosa/KOMPLA_BRAK_IDP_OIDC/issuer"
BRAK_IDP_OIDC_REDIRECT_URI="op://4ytk2qggj7l4yydaw64xktlosa/KOMPLA_BRAK_IDP_OIDC/redirect_uri"

# HTTP Basic Auth (staging / pre-launch only)
HTTP_CREDENTIALS_USERNAME="op://4ytk2qggj7l4yydaw64xktlosa/KOMPLA_BASIC_AUTH_STAGING/username"
HTTP_CREDENTIALS_PASSWORD="op://4ytk2qggj7l4yydaw64xktlosa/KOMPLA_BASIC_AUTH_STAGING/password"

# KomPla Backend API
KOMPLA_API_URL="op://4ytk2qggj7l4yydaw64xktlosa/KOMPLA_API/url"

# KomPla Identity Provider
KOMPLA_IDP_OIDC_CLIENT_ID="op://4ytk2qggj7l4yydaw64xktlosa/KOMPLA_IDP_OIDC/client_id"
KOMPLA_IDP_OIDC_CLIENT_SECRET="op://4ytk2qggj7l4yydaw64xktlosa/KOMPLA_IDP_OIDC/client_secret"
KOMPLA_IDP_OIDC_ISSUER="op://4ytk2qggj7l4yydaw64xktlosa/KOMPLA_IDP_OIDC/issuer"
KOMPLA_IDP_OIDC_BRAK_SUBJECT_ISSUER="op://4ytk2qggj7l4yydaw64xktlosa/KOMPLA_IDP_OIDC/brak_subject_issuer"
KOMPLA_IDP_OIDC_BRAK_TOKEN_ENDPOINT="op://4ytk2qggj7l4yydaw64xktlosa/KOMPLA_IDP_OIDC/brak_token_endpoint"

# Magic Link Login (Guest Access)
KOMPLA_MAGIC_LINK_CLIENT_ID="op://4ytk2qggj7l4yydaw64xktlosa/KOMPLA_MAGIC_LINK/client_id"
KOMPLA_MAGIC_LINK_SERVICE_CLIENT_ID="op://4ytk2qggj7l4yydaw64xktlosa/KOMPLA_MAGIC_LINK/service_client_id"
KOMPLA_MAGIC_LINK_SERVICE_CLIENT_SECRET="op://4ytk2qggj7l4yydaw64xktlosa/KOMPLA_MAGIC_LINK/client_secret"
KOMPLA_MAGIC_LINK_DEMO_USERNAME="op://4ytk2qggj7l4yydaw64xktlosa/KOMPLA_MAGIC_LINK/demo_username"
KOMPLA_MAGIC_LINK_DEMO_EMAIL="op://4ytk2qggj7l4yydaw64xktlosa/KOMPLA_MAGIC_LINK/demo_email"

# Sentry
SENTRY_DSN=
# SENTRY_DSN="op://4ytk2qggj7l4yydaw64xktlosa/KOMPLA_SENTRY/dsn"
